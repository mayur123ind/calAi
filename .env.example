# Copy this file to .env.local and fill in your key.

# Free key from https://aistudio.google.com -> Get API key
# (If GEMINI_API_KEY is already set in your Windows environment, that value wins over this file.)
GEMINI_API_KEY=your-key-here

# "latest" aliases always point at Google's current Flash models.
# The fallback is used when the main model is busy or out of free quota.
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# Supabase Postgres (Connect -> Direct -> Session pooler). See README "Setup".
# The app signs in as calai_app; npm run db:setup creates that role with this password.
DATABASE_URL=postgresql://calai_app.<project-ref>:<long-random-password>@<pooler-host>:5432/postgres
# Admin login: only for npm run db:setup, never used by the app.
DATABASE_ADMIN_URL=postgresql://postgres.<project-ref>:<db-password>@<pooler-host>:5432/postgres

# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Encrypts people's own AI API keys in the database.
DATA_ENCRYPTION_KEY=
